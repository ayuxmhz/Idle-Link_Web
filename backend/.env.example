# Server
PORT=8089

# MongoDB
MONGODB_URL=mongodb://127.0.0.1:27017/idlelink-db

# JWT
SECRET_KEY=change-this-to-a-long-random-string

# Frontend origin (used to build eSewa success/failure redirect URLs)
FRONTEND_URL=http://localhost:3000

# Transactional email (Resend — https://resend.com/api-keys) for email OTP and
# password reset. Leave unset in development to fall back to logging the code
# to the console instead of failing the request.
RESEND_API_KEY=
# Only needed if you've verified your own sending domain in Resend — otherwise
# the default onboarding@resend.dev sender works out of the box.
RESEND_FROM_EMAIL=IdleLink <onboarding@resend.dev>

# eSewa ePay v2 (wallet deposits). Defaults to eSewa's own published test/sandbox
# credentials if left unset — safe for local development, no signup required.
# Test sandbox login (rc-epay.esewa.com.np): eSewa ID 9806800001..9806800005,
# password Nepal@123, MPIN 1122, OTP 123456.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# AI Job Matcher (Google GenAI / Gemini). Get a key from https://aistudio.google.com/apikey
# The matcher endpoint returns a clear "not configured" error until this is set.
GEMINI_API_KEY=
